/* 页面和主操作样式：页面按需引入，避免影响现有功能。 */
.adaptive-page { box-sizing: border-box; width: 100%; max-width: 560px; margin: 0 auto; padding: 48rpx 32rpx 72rpx; }
.adaptive-action { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 96rpx; padding: 16rpx 24rpx; border: 1rpx solid rgba(183, 206, 239, .22); border-radius: 20rpx; background: #3b5884; color: #f4f8ff; font-size: 30rpx; font-weight: 700; }
.adaptive-action-hover { background: #496a9b; }
.adaptive-action-icon { margin-right: 10rpx; font-size: 36rpx; font-weight: 400; }
@media (min-width: 600px) {
  .adaptive-page { padding: 32px 28px 48px; }
  .adaptive-action { min-height: 56px; padding: 12px 20px; border-radius: 12px; font-size: 18px; }
  .adaptive-action-icon { margin-right: 6px; font-size: 22px; }
}
