page {
  min-height: 100%;
  background: #071e14;
  color: #eee8c7;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

view, text, button, input, scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  color: inherit;
  background: transparent;
  line-height: inherit;
}

button::after { border: 0; }

.page {
  min-height: 100vh;
  padding: 28rpx;
}

.panel {
  background: rgba(30, 57, 43, .82);
  border: 2rpx solid rgba(190, 213, 190, .16);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.panel-title {
  color: #eee8c7;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
}

.muted { color: #9bb4a2; }
.gold { color: #d5bd5b; }
.teal { color: #2fb5a1; }

.primary-button {
  min-height: 92rpx;
  padding: 20rpx 32rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  background: linear-gradient(110deg, #279c84, #087f70);
  box-shadow: 0 10rpx 24rpx rgba(5, 116, 98, .24);
}

.field-input {
  min-height: 84rpx;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(202, 221, 202, .15);
  background: rgba(225, 237, 223, .09);
  color: #f1e9c9;
}

.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
