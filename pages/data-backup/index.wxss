page{background:#f3f3ef;color:#29392f}.page{max-width:900px;margin:auto;padding:32rpx 30rpx 80rpx;box-sizing:border-box}.title{font-size:42rpx;font-weight:800}.intro,.hint{color:#758479;font-size:24rpx;line-height:1.7}.intro{margin:18rpx 0 28rpx}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 6rpx 26rpx rgba(28,52,36,.05)}.heading{font-size:32rpx;font-weight:700;margin-bottom:20rpx}.option,.line{display:flex;align-items:center;gap:16rpx;min-height:70rpx;font-size:27rpx}.project-list{padding:10rpx 0 12rpx 25rpx}.project-scroll{max-height:300rpx}.line{justify-content:space-between;border-top:1rpx solid #e7ece7;margin-top:12rpx}.passwords{display:grid;gap:14rpx;margin:15rpx 0}input{background:#f1f5f1;border-radius:12rpx;padding:14rpx 18rpx;font-size:27rpx;min-height:56rpx}.primary,.secondary,.small{margin:12rpx 0 0;border-radius:14rpx;font-size:26rpx;font-weight:600}.primary{background:#346e58;color:white}.secondary{background:#e9f1eb;color:#345e4c}.actions{display:flex;gap:12rpx;align-items:center;flex-wrap:wrap}.actions button{flex:1;min-width:150rpx}.file{padding:18rpx 0;border-top:1rpx solid #e8ede8}.file-name{font-size:24rpx;word-break:break-all}.file-actions{display:flex;gap:12rpx}.small{background:#edf3ee;color:#345e4c;padding:0 20rpx;line-height:64rpx}.chosen{background:#386f59;color:white}.empty{padding:20rpx 0}.status{padding:20rpx;color:#346e58;font-size:25rpx}.conflict{padding:20rpx 0;border-top:1rpx solid #e6ebe6;font-size:23rpx;line-height:1.6;word-break:break-all}.conflict-title{font-weight:700;color:#29392f}
.main-action{min-height:88rpx;padding:20rpx 24rpx;line-height:1.5;display:flex;align-items:center;justify-content:center;width:100%}
.file-actions button{flex:1;min-width:0;white-space:nowrap}
