page { background: #0b2115; color: #f0e7c9; }
.session-page { max-width: 840rpx; margin: 0 auto; padding: 30rpx 28rpx 70rpx; }
.session-header { padding: 12rpx 4rpx 22rpx; }
.header-top, .header-meta, .section-heading, .panel-heading, .field-row, .entry-row, .player-name-row, .group-row, .record-actions, .result-row, .transfer-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.eyebrow { color: #87ae97; font-size: 21rpx; letter-spacing: 3rpx; }
.session-title { margin-top: 8rpx; font-size: 40rpx; font-weight: 800; }
.edit-hint { color: #8eb39b; font-size: 23rpx; font-weight: 400; }
.text-action { color: #77d1ae; font-size: 24rpx; white-space: nowrap; }
.header-meta { margin-top: 18rpx; color: #a7c4ae; font-size: 24rpx; }
.price-control { display: flex; align-items: center; gap: 8rpx; }
.price-control input { width: 115rpx; height: 55rpx; border-radius: 10rpx; padding: 0 10rpx; text-align: right; color: #f3e6bd; background: #254533; }
.save-warning { margin-top: 16rpx; color: #ffc4a9; font-size: 24rpx; }
.tabs { display: flex; gap: 10rpx; margin: 8rpx 0 30rpx; }
.tab, .mode { flex: 1; padding: 18rpx 8rpx; border-radius: 14rpx; background: #234433; color: #adcbb7; font-size: 26rpx; font-weight: 700; text-align: center; }
.tab.selected, .mode.selected { color: #253c2d; background: #e3cb8a; }
.section-heading { margin: 0 4rpx 18rpx; }
.section-title { color: #f2e9c9; font-size: 33rpx; font-weight: 800; }
.section-caption, .help-text { color: #9bbba4; font-size: 22rpx; line-height: 1.55; }
.section-caption { margin-top: 6rpx; }
.panel { padding: 24rpx; margin-bottom: 18rpx; border-color: rgba(190, 213, 190, .14); }
.panel-heading { min-height: 50rpx; color: #eee6c8; font-size: 29rpx; font-weight: 700; }
.chevron { color: #a0bda8; font-size: 22rpx; font-weight: 400; }
.status { margin-left: 8rpx; padding: 5rpx 9rpx; border-radius: 8rpx; font-size: 20rpx; font-weight: 500; }
.status.ok { color: #a8e5c7; background: #285c43; }
.status.pending { color: #f3d49a; background: #5c482a; }
.field-row { min-height: 82rpx; border-bottom: 1rpx solid rgba(208, 230, 207, .1); color: #c3d4c4; font-size: 26rpx; }
.input { min-height: 64rpx; padding: 8rpx 14rpx; border: 1rpx solid #547360; border-radius: 12rpx; background: #203f2d; color: #f4eacb; font-size: 27rpx; text-align: right; }
.compact { width: 180rpx; }
.score-input { width: 155rpx; }
.sign-button { flex: none; padding: 12rpx 10rpx; border: 1rpx solid #64856c; border-radius: 10rpx; color: #b7d6c0; background: #244b35; font-size: 22rpx; white-space: nowrap; }
.sign-button.is-negative { border-color: #b87868; color: #ffc0ad; background: #633d33; }
.fee-input { width: 175rpx; }
.picker-value, .fee-value { color: #e9ddb2; font-size: 25rpx; }
.entry-row { min-height: 84rpx; border-bottom: 1rpx solid rgba(208, 230, 207, .08); }
.participant { flex: 1; display: flex; align-items: center; gap: 12rpx; min-width: 0; color: #e5ebd5; font-size: 26rpx; }
.check { display: inline-flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border: 1rpx solid #607f6b; border-radius: 50%; color: #88a695; font-size: 25rpx; }
.check.checked { border-color: #38b990; color: white; background: #258d6f; }
.delta { color: #a9cdb1; font-size: 22rpx; }
.validation { padding: 14rpx; margin-top: 18rpx; border-radius: 10rpx; font-size: 23rpx; line-height: 1.5; }
.validation.valid { color: #a7e1bd; background: rgba(48, 139, 93, .2); }
.validation.invalid { color: #f6cb9b; background: rgba(174, 115, 46, .18); }
.record-actions { margin-top: 16rpx; }
.danger-link { color: #e3a5a0; font-size: 22rpx; }
.primary-action, .outline-button { display: flex; min-height: 82rpx; align-items: center; justify-content: center; border-radius: 16rpx; font-size: 28rpx; font-weight: 700; }
.primary-action { color: white; background: #238965; }
.outline-button { margin-top: 20rpx; border: 1rpx solid #5b856b; color: #cce4d1; background: #214431; }
.empty-panel { padding: 42rpx 20rpx; margin-bottom: 18rpx; border: 1rpx solid #3b5a45; border-radius: 18rpx; color: #9fbca8; text-align: center; font-size: 25rpx; }
.player-item, .group-row { padding: 16rpx 0; border-bottom: 1rpx solid rgba(208, 230, 207, .09); }
.player-name, .group-name { color: #ebead3; font-size: 27rpx; font-weight: 700; }
.group-actions { display: flex; gap: 20rpx; align-items: center; }
.active-control { display: flex; align-items: center; color: #a9c5af; font-size: 21rpx; }
.group-change { max-width: 56%; overflow: hidden; color: #77d1ae; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.attendance-controls { display: flex; gap: 10rpx; flex-wrap: wrap; justify-content: space-between; margin-top: 10rpx; }
.picker-line { display: flex; justify-content: space-between; margin-top: 8rpx; color: #aac7b1; font-size: 23rpx; }
.mode-label { margin-top: 24rpx; color: #e5e8d1; font-size: 26rpx; font-weight: 700; }
.mode-toggle { display: flex; gap: 8rpx; margin: 14rpx 0; }
.mode { padding: 13rpx 6rpx; font-size: 23rpx; }
.result-row { min-height: 76rpx; border-bottom: 1rpx solid rgba(208, 230, 207, .08); color: #e4ead8; font-size: 25rpx; }
.group-chip { display: inline-block; margin-left: 10rpx; padding: 4rpx 8rpx; border-radius: 8rpx; color: #a8dfc3; background: #285640; font-size: 20rpx; }
.positive { color: #8ce1bd; font-weight: 700; }
.negative { color: #f0ac9d; font-weight: 700; }
.fee-details { color: #bfceb9; font-size: 22rpx; text-align: right; }
.transfer-row { min-height: 70rpx; color: #e9e9ce; font-size: 26rpx; font-weight: 700; }
.arrow { color: #7bc8a6; padding: 0 5rpx; }
.transfer-row > text { color: #8ce1bd; }
.footer-note { padding-top: 28rpx; color: #779883; font-size: 22rpx; text-align: center; }
.save-record-hint { margin: 12rpx 4rpx 0; }
.records-section { margin-top: 30rpx; }
.records-section > .section-title { margin: 0 4rpx 16rpx; }
.saved-score { color: #dbdfc8; font-size: 23rpx; text-align: right; white-space: nowrap; }
.saved-transfer-heading { margin-top: 16rpx; color: #e7d99c; font-size: 24rpx; font-weight: 700; }
.saved-transfer { margin-top: 8rpx; color: #c5ddc9; font-size: 23rpx; }
.dialog-backdrop { position: fixed; z-index: 100; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(0, 0, 0, .68); }
.dialog-card { width: 100%; max-width: 610rpx; max-height: 80vh; overflow-y: auto; padding: 30rpx; border: 1rpx solid #52755e; border-radius: 24rpx; background: #17382a; box-shadow: 0 18rpx 60rpx rgba(0, 0, 0, .4); }
.dialog-title { color: #f5e8c4; font-size: 32rpx; font-weight: 800; }
.dialog-note { margin-top: 18rpx; color: #aecbb5; font-size: 24rpx; line-height: 1.6; }
.dialog-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.dialog-option { min-width: 140rpx; max-width: 100%; padding: 18rpx 22rpx; border: 1rpx solid #4b745d; border-radius: 14rpx; color: #deebd9; background: #244b35; font-size: 26rpx; text-align: center; word-break: break-all; }
.dialog-option.chosen { border-color: #6acbaa; color: #9ff0d0; background: #245b44; }
.dialog-input { width: 100%; min-height: 82rpx; margin-top: 20rpx; padding: 12rpx 16rpx; border: 1rpx solid #5b836b; border-radius: 12rpx; color: #f4edce; background: #102c1e; font-size: 28rpx; }
.dialog-error { margin-top: 10rpx; color: #ffbbaa; font-size: 23rpx; }
.dialog-actions { display: flex; gap: 12rpx; margin-top: 26rpx; }
.dialog-actions button, .dialog-cancel-wide { flex: 1; min-height: 78rpx; border-radius: 13rpx; font-size: 27rpx; font-weight: 700; line-height: 78rpx; }
.dialog-cancel, .dialog-cancel-wide { color: #c4dcc9; background: #28503a; }
.dialog-cancel-wide { width: 100%; margin-top: 24rpx; }
.dialog-confirm { color: white; background: #218d6d; }
.dialog-confirm.danger { background: #955246; }
.allocation-action { margin: 20rpx 0; padding: 18rpx 20rpx; border: 1rpx solid #4b8062; border-radius: 14rpx; color: #9ce0bf; background: #1b4932; font-size: 25rpx; text-align: center; }
.allocation-row { padding: 18rpx 0 4rpx; border-bottom: 1rpx solid rgba(208, 230, 207, .1); }
.allocation-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; color: #e4ead8; font-size: 25rpx; }
.allocation-heading > view { display: flex; align-items: center; gap: 8rpx; }
.allocation-input { width: 150rpx; height: 60rpx; padding: 0 10rpx; border: 1rpx solid #5b836b; border-radius: 10rpx; color: #f4edce; background: #102c1e; text-align: right; }
.allocation-reset { margin-top: 20rpx; color: #9ce0bf; font-size: 24rpx; text-align: center; }
.people-entry { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 110rpx; padding: 20rpx 24rpx; margin-bottom: 24rpx; border: 1rpx solid #477a5c; border-radius: 18rpx; background: #1b4630; transition: transform .15s, opacity .15s; }
.people-entry-title { color: #e3f1df; font-size: 27rpx; font-weight: 700; line-height: 1.5; }
.people-count { margin-left: 10rpx; color: #b0d6bd; font-size: 21rpx; font-weight: 400; }
.people-entry-caption { margin-top: 5rpx; color: #a8cbb1; font-size: 22rpx; line-height: 1.5; }
.people-entry-arrow, .people-entry-link { flex: none; color: #8de0b7; font-size: 24rpx; }
.people-entry-arrow { font-size: 40rpx; }
.people-pressed { opacity: .82; transform: scale(.98); }
.people-backdrop { position: fixed; z-index: 90; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; justify-content: center; background: rgba(0, 0, 0, .7); }
.people-sheet { box-sizing: border-box; width: 100%; max-width: 840rpx; max-height: 87vh; padding: 26rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); border: 1rpx solid #4e775d; border-radius: 28rpx 28rpx 0 0; background: #123322; }
.people-sheet-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding-bottom: 18rpx; }
.people-sheet-title { color: #f1e9c9; font-size: 33rpx; font-weight: 800; }
.people-sheet-caption { margin-top: 7rpx; color: #a5c8ae; font-size: 22rpx; }
.people-close { flex: none; padding: 15rpx 19rpx; border-radius: 12rpx; color: #b7ecd0; background: #285d42; font-size: 25rpx; }
.people-scroll { height: 65vh; max-height: 71vh; }
.people-summary { padding: 14rpx 16rpx; border-radius: 12rpx; color: #bad6bf; background: #1e4932; font-size: 22rpx; line-height: 1.5; }
.people-person { padding: 18rpx 0; border-bottom: 1rpx solid rgba(208, 230, 207, .1); }
.people-person-heading { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.people-name { color: #f0ecd8; font-size: 27rpx; font-weight: 700; word-break: break-all; }
.people-presence { flex: none; color: #a6ae9b; font-size: 21rpx; }
.people-presence.is-present { color: #85d9ac; }
.people-controls { display: flex; gap: 12rpx; margin-top: 14rpx; }
.people-control { display: flex; flex: 1; align-items: center; justify-content: center; min-width: 0; min-height: 68rpx; padding: 8rpx; border: 1rpx solid #577766; border-radius: 12rpx; color: #b6cdbb; background: #254231; font-size: 22rpx; text-align: center; transition: transform .15s, opacity .15s; }
.people-control.is-active { border-color: #72cda0; color: #e1f8e7; background: #28714d; }
.people-period { margin-top: 12rpx; color: #9fc1a7; font-size: 21rpx; line-height: 1.6; }
.period-label { display: block; }
.period-times { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.period-time { padding: 7rpx 10rpx; border-radius: 8rpx; color: #c0e4cc; background: #28503a; }
.period-open { color: #84cda3; }
.people-add { width: 100%; }
.people-help { padding: 16rpx 0; }
.presence-fields { margin-top: 18rpx; }
.presence-field { display: flex; align-items: center; justify-content: space-between; min-height: 74rpx; padding: 0 16rpx; margin-top: 10rpx; border: 1rpx solid #567b61; border-radius: 12rpx; color: #d5e6d3; background: #214832; font-size: 25rpx; }
