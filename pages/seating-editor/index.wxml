<view class="page">
  <view class="header"><view bindtap="openRename"><view class="eyebrow">聚会座位图 · 点击名称修改</view><view class="title">{{title}}</view></view><text class="status">{{saveStatus}}</text></view>
  <view id="stage" class="stage"><canvas id="canvas" type="2d" class="canvas" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel"/><view wx:if="{{dragName}}" class="drag-label" style="left:{{dragX}}px;top:{{dragY}}px">{{dragName}}</view></view>
  <view class="toolbar"><button bindtap="addTable">＋ 桌子</button><button bindtap="addFreeSeat">＋ 座位</button><button bindtap="openTables">桌子列表</button><button bindtap="openPeople">人员名单</button></view><view class="toolbar"><button bindtap="openObjects">场地元素</button><button bindtap="toggleDraw">{{mode==='draw'?'完成画线':'画线'}}</button><button bindtap="undo">撤回</button><button bindtap="openVenue">场地尺寸</button><button bindtap="openExport">导出图片</button></view>
  <view wx:if="{{mode!=='poly'}}" class="toolbar"><button bindtap="startPolyline">点拐角画折线</button><button bindtap="toggleSnap">桌子对齐：{{snap?'开':'关'}}</button></view><view wx:else class="toolbar"><button data-closed="{{false}}" bindtap="finishPolyline">完成折线</button><button data-closed="{{true}}" bindtap="finishPolyline">闭合区域</button><button bindtap="cancelPolyline">取消绘制</button></view>
  <view wx:if="{{panel==='people' || panel==='choose'}}" class="mask">
    <view class="sheet">
      <view class="sheet-heading"><text>{{panel==='choose'?'选择入座人员':'人员名单'}}</text><text bindtap="closePanel">✕</text></view>
      <view class="input-row"><textarea value="{{names}}" bindinput="namesInput" placeholder="输入姓名，用逗号、空格或换行分隔"/><button bindtap="addNames">添加</button></view>
      <button wx:if="{{panel==='people'}}" class="auto" bindtap="autoAssign">自动安排未入座人员</button>
      <view wx:if="{{panel==='choose'}}" class="toolbar"><button bindtap="clearSeat">移出座位</button><button bindtap="deleteSeatedPerson">删除此人</button><button wx:if="{{selectedIsFree}}" bindtap="deleteFreeSeat">删除座位</button></view>
      <input class="search" value="{{search}}" bindinput="searchInput" placeholder="搜索姓名或备注"/>
      <scroll-view scroll-y="true" class="people-list"><view wx:for="{{people}}" wx:key="id" class="person" data-id="{{item.id}}" bindtap="peopleTap"><text>{{item.name}}{{item.note?' · '+item.note:''}}</text><view><text class="{{item.seated?'seated':'available'}}">{{item.seated?'已入座 · '+item.tableName:'未入座'}}</text><text class="edit-person" data-id="{{item.id}}" catchtap="openPerson"> 编辑</text></view></view></scroll-view>
    </view>
  </view>
  <view wx:if="{{panel==='tables'}}" class="mask"><view class="sheet"><view class="sheet-heading"><text>桌子列表</text><text bindtap="closePanel">✕</text></view><view class="toolbar"><button data-visible="{{true}}" bindtap="namesVisibility">显示所有桌名</button><button data-visible="{{false}}" bindtap="namesVisibility">隐藏所有桌名</button></view><scroll-view scroll-y="true" class="people-list"><view wx:for="{{tables}}" wx:key="id" class="table-row" data-id="{{item.id}}" bindtap="locateTableTap"><view>{{item.label}}</view><view class="table-members">{{item.members || '暂无入座人员'}}</view></view></scroll-view></view></view>
  <view wx:if="{{panel==='table'}}" class="mask">
    <view class="sheet">
      <view class="sheet-heading"><text>桌子设置</text><text bindtap="closePanel">✕</text></view>
      <view class="preview-hint">点击桌边选择是否安排座位，拖动橙色点调整大小</view><canvas type="2d" id="table-preview" class="table-preview" bindtap="tablePreviewTap" bindtouchstart="previewResizeStart" bindtouchmove="previewResizeMove" bindtouchend="previewResizeEnd"/>
      <scroll-view scroll-y="true" class="table-settings">
      <view class="field"><text>桌型</text><view class="choice" bindtap="openTableTypes">{{tableTypes[draftType]}} ▾</view></view>
      <view class="field"><text>名称（可不填）</text><input value="{{draftName}}" data-key="draftName" bindinput="tableInput" placeholder="例如主桌"/></view>
      <view class="field"><text>在图中显示桌名</text><switch checked="{{draftShowName}}" bindchange="tableNameVisibility" color="#547c63"/></view>
      <view class="field"><text>人数</text><input type="number" value="{{draftSeatCount}}" data-key="draftSeatCount" bindinput="tableInput"/></view>
      <view class="field"><text>宽（{{dimensionUnit}}）</text><input type="digit" value="{{draftWidth}}" data-key="draftWidth" bindinput="tableInput"/></view>
      <view class="field"><text>高（{{dimensionUnit}}）</text><input type="digit" value="{{draftHeight}}" data-key="draftHeight" bindinput="tableInput"/></view>
      <view class="field"><text>旋转角度</text><text>{{draftRotation}}°</text></view><slider min="0" max="360" value="{{draftRotation}}" bindchanging="rotationInput" bindchange="rotationInput" activeColor="#547c63"/>
      <view wx:if="{{typeValues[draftType]==='t'}}" class="field"><text>横板厚度（{{dimensionUnit}}）</text><input type="digit" value="{{draftHead}}" data-key="draftHead" bindfocus="partFocus" bindinput="tableInput"/></view>
      <view wx:if="{{typeValues[draftType]==='t'}}" class="field"><text>桌腿宽度（{{dimensionUnit}}）</text><input type="digit" value="{{draftStem}}" data-key="draftStem" bindfocus="partFocus" bindinput="tableInput"/></view>
      <view wx:if="{{typeValues[draftType]==='u'}}" class="field"><text>两侧宽度（{{dimensionUnit}}）</text><input type="digit" value="{{draftLeg}}" data-key="draftLeg" bindfocus="partFocus" bindinput="tableInput"/></view>
      <view wx:if="{{typeValues[draftType]==='u'}}" class="field"><text>底边厚度（{{dimensionUnit}}）</text><input type="digit" value="{{draftBase}}" data-key="draftBase" bindfocus="partFocus" bindinput="tableInput"/></view>
      <view class="field"><text>可安排座位的方向</text></view>
      <checkbox-group class="edge-options" bindchange="tableEdges"><label><checkbox value="top" checked="{{edgeTop}}"/>上</label><label><checkbox value="right" checked="{{edgeRight}}"/>右</label><label><checkbox value="bottom" checked="{{edgeBottom}}"/>下</label><label><checkbox value="left" checked="{{edgeLeft}}"/>左</label></checkbox-group>
      </scroll-view>
      <view class="toolbar"><button bindtap="saveTable">保存桌子</button><button bindtap="copyTable">复制</button><button bindtap="openGrid">批量</button><button bindtap="deleteTable">删除</button></view>
    </view>
  </view>
  <view wx:if="{{panel==='grid'}}" class="mask"><view class="sheet"><view class="sheet-heading"><text>批量生成桌子</text><text bindtap="closePanel">✕</text></view><view class="preview-hint">左右、上下拖动预览或滑动调节间距</view><canvas type="2d" id="grid-preview" class="table-preview" bindtouchstart="gridStart" bindtouchmove="gridMove" bindtouchend="gridEnd"/><view class="field"><text>行数</text><input type="number" value="{{gridRows}}" data-key="gridRows" bindinput="gridInput"/></view><view class="field"><text>列数</text><input type="number" value="{{gridColumns}}" data-key="gridColumns" bindinput="gridInput"/></view><view class="field"><text>横向桌边间距</text><text>{{gapX}} {{gridUnit}}</text></view><slider min="0" max="{{gridMax}}" step="{{gridStep}}" value="{{gapX}}" data-key="gapX" bindchanging="gridSlider" bindchange="gridSlider"/><view class="field"><text>纵向桌边间距</text><text>{{gapY}} {{gridUnit}}</text></view><slider min="0" max="{{gridMax}}" step="{{gridStep}}" value="{{gapY}}" data-key="gapY" bindchanging="gridSlider" bindchange="gridSlider"/><button class="auto" bindtap="addGrid">生成桌子</button></view></view>
  <view wx:if="{{panel==='venue'}}" class="mask"><view class="sheet"><view class="sheet-heading"><text>场地尺寸（可选）</text><text bindtap="closePanel">✕</text></view><view class="field"><text>宽（米）</text><input type="digit" value="{{venueWidth}}" data-key="venueWidth" bindinput="venueInput"/></view><view class="field"><text>高（米）</text><input type="digit" value="{{venueHeight}}" data-key="venueHeight" bindinput="venueInput"/></view><view class="toolbar"><button class="auto" bindtap="saveVenue">确定</button><button wx:if="{{venueWidth && venueHeight}}" bindtap="clearVenue">取消场地尺寸</button></view></view></view>
  <view wx:if="{{panel==='objects'}}" class="mask"><view class="sheet"><view class="sheet-heading"><text>场地元素</text><text bindtap="closePanel">✕</text></view><view class="element-grid"><button data-kind="wall" bindtap="addObject">墙壁</button><button data-kind="door" bindtap="addObject">门</button><button data-kind="stage" bindtap="addObject">舞台</button><button data-kind="path" bindtap="addObject">通道</button><button data-kind="entry" bindtap="addObject">入口</button><button data-kind="exit" bindtap="addObject">出口</button><button data-kind="wc" bindtap="addObject">卫生间</button><button data-kind="text" bindtap="addObject">文字</button></view></view></view>
  <view wx:if="{{panel==='object'}}" class="mask"><view class="sheet"><view class="sheet-heading"><text>编辑元素</text><text bindtap="closePanel">✕</text></view><scroll-view scroll-y="true" class="table-settings"><view class="preview-hint">拖动橙色点调整大小</view><canvas type="2d" id="object-preview" class="table-preview" bindtouchstart="objectResizeStart" bindtouchmove="objectResizeMove" bindtouchend="objectResizeEnd"/><view class="field"><text>文字</text><input value="{{objectText}}" data-key="objectText" bindinput="objectInput"/></view><view class="field"><text>线条粗细</text><input type="digit" value="{{objectWidth}}" data-key="objectWidth" bindinput="objectInput"/></view><view wx:if="{{objectHasShape}}" class="field"><text>宽（{{objectUnit}}）</text><input type="digit" value="{{objectShapeWidth}}" data-key="objectShapeWidth" bindinput="objectInput"/></view><view wx:if="{{objectHasShape}}" class="field"><text>高（{{objectUnit}}）</text><input type="digit" value="{{objectShapeHeight}}" data-key="objectShapeHeight" bindinput="objectInput"/></view><view wx:if="{{objectHasShape}}" class="field"><text>旋转 {{objectAngle}}°</text></view><slider wx:if="{{objectHasShape}}" min="0" max="360" value="{{objectAngle}}" bindchanging="objectRotation" bindchange="objectRotation"/><view class="field"><text>颜色</text><view class="color-options"><view class="color-dot green" data-color="#46554d" bindtap="objectColor"/><view class="color-dot red" data-color="#ae5b52" bindtap="objectColor"/><view class="color-dot blue" data-color="#487698" bindtap="objectColor"/><view class="color-dot gold" data-color="#ac8844" bindtap="objectColor"/></view></view></scroll-view><view class="toolbar"><button bindtap="saveObject">保存</button><button wx:if="{{objectCanDelete}}" bindtap="deleteObject">删除元素</button></view></view></view>
  <view wx:if="{{panel==='rename'}}" class="mask"><view class="sheet"><view class="sheet-heading"><text>座位图名称</text><text bindtap="closePanel">✕</text></view><input class="search" value="{{projectName}}" bindinput="projectNameInput" maxlength="60" placeholder="输入名称"/><button class="auto" bindtap="saveName">保存</button></view></view>
  <view wx:if="{{panel==='person'}}" class="mask"><view class="sheet"><view class="sheet-heading"><text>编辑人员</text><text bindtap="closePanel">✕</text></view><view class="field"><text>姓名或昵称</text><input value="{{personName}}" data-key="personName" bindinput="personInput"/></view><view class="field"><text>备注（可选）</text><input value="{{personNote}}" data-key="personNote" bindinput="personInput"/></view><view class="toolbar"><button bindtap="savePerson">保存</button><button bindtap="removePerson">删除人员</button></view></view></view>
  <view wx:if="{{showTableTypes}}" class="mask" style="z-index:20"><view class="sheet"><view class="sheet-heading"><text>选择桌型</text><text bindtap="closeTableTypes">✕</text></view><view class="choice-grid"><button wx:for="{{tableTypes}}" wx:key="*this" data-index="{{index}}" bindtap="chooseTableType" class="{{draftType===index?'selected':''}}">{{item}}</button></view></view></view>
</view>
