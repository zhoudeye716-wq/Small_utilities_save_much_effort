page{background:#f4f3ed;color:#263b32}.page{max-width:1200px;margin:auto;padding:22rpx;box-sizing:border-box}.header{display:flex;justify-content:space-between;align-items:center;margin:4rpx 0 18rpx}.eyebrow{font-size:19rpx;letter-spacing:2rpx;color:#85968a}.title{font-size:32rpx;font-weight:700;margin-top:4rpx}.status{font-size:20rpx;color:#758c7e}.stage{position:relative;height:62vh;min-height:320px;background:#fff;border:1px solid #dde6df;border-radius:18rpx;overflow:hidden}.canvas{width:100%;height:100%;display:block}.drag-label{position:absolute;transform:translate(-50%,-135%);padding:10rpx 20rpx;border-radius:12rpx;background:#284d3d;color:white;font-size:28rpx;pointer-events:none}.toolbar{display:flex;gap:12rpx;margin-top:18rpx}button::after{border:0}.toolbar button{flex:1;margin:0;background:#e1e9e1;color:#345745;font-size:23rpx;border-radius:13rpx}.mask{position:fixed;inset:0;background:rgba(16,32,24,.52);display:flex;align-items:flex-end;justify-content:center;z-index:10}.sheet{box-sizing:border-box;width:100%;max-width:850px;max-height:85vh;background:#fffefa;border-radius:25rpx 25rpx 0 0;padding:28rpx}.sheet-heading{display:flex;justify-content:space-between;font-size:30rpx;font-weight:700;margin-bottom:20rpx}.input-row{display:flex;gap:12rpx;align-items:center}.input-row textarea{flex:1;width:auto;height:100rpx;background:#f0f4ef;border-radius:12rpx;padding:12rpx;font-size:23rpx}.input-row button,.auto{background:#547c63;color:white;font-size:23rpx}.auto{margin:18rpx 0}.people-list{max-height:48vh}.person{padding:18rpx 4rpx;border-bottom:1px solid #edf1eb;display:flex;justify-content:space-between;font-size:24rpx}.available{color:#4f9170}.seated{color:#9caaa0}
.field{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;padding:10rpx 0}.field input{width:45%;text-align:right;background:#f0f4ef;border-radius:10rpx;padding:8rpx}.edge-options{display:flex;justify-content:space-around;font-size:23rpx}.edge-options checkbox{transform:scale(.75)}
.search{background:#f0f4ef;border-radius:12rpx;padding:14rpx;margin:16rpx 0;font-size:24rpx}.table-row{padding:18rpx 4rpx;border-bottom:1px solid #edf1eb;font-size:25rpx}.table-members{font-size:21rpx;color:#8a9b90;margin-top:8rpx;line-height:1.5}
.preview-hint{font-size:21rpx;color:#7a8e80}.table-preview{display:block;width:100%;height:130px;background:#f3f5ef;border-radius:12rpx;margin:10rpx 0}
.table-settings{max-height:52vh}
.element-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.element-grid button{margin:0;background:#edf2ec;color:#496b55;font-size:22rpx}
.color-options{display:flex;gap:16rpx}.color-dot{width:32rpx;height:32rpx;border-radius:50%}.color-dot.green{background:#46554d}.color-dot.red{background:#ae5b52}.color-dot.blue{background:#487698}.color-dot.gold{background:#ac8844}
.edit-person{padding:10rpx;color:#56866b}
.toolbar{flex-wrap:wrap}.toolbar button{min-width:100rpx;min-height:76rpx;line-height:1.35;padding:17rpx 12rpx}.element-grid button,.input-row button,.auto{min-height:76rpx;line-height:1.35;padding:17rpx 12rpx}.field{min-height:68rpx}.field input{min-height:56rpx;box-sizing:border-box}.sheet{max-height:94vh}.table-settings{max-height:45vh}.table-preview{height:155px}.choice{display:flex;justify-content:space-between;align-items:center;min-height:68rpx;padding:0 20rpx;border-radius:12rpx;background:#edf2ec;color:#345745}.choice-grid{display:flex;flex-wrap:wrap;gap:14rpx}.choice-grid button{min-width:28%;min-height:78rpx;line-height:1.4;padding:18rpx;background:#edf2ec;color:#345745}.choice-grid button.selected{background:#547c63;color:white}
