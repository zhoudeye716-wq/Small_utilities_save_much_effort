page{background:#f4f3ed;color:#263b32}.page{box-sizing:border-box;max-width:860px;margin:auto;padding:36rpx 32rpx 80rpx}.eyebrow{color:#7d9285;font-size:21rpx;letter-spacing:3rpx}.heading{font-size:48rpx;font-weight:700;margin-top:14rpx}.intro{font-size:25rpx;color:#708478;line-height:1.6;margin:16rpx 0 30rpx}button::after{border:0}.create{background:#365e4c;color:white;border-radius:20rpx;font-size:28rpx;padding:14rpx}.section-title{font-size:28rpx;font-weight:700;margin:42rpx 0 20rpx}.project{display:flex;align-items:center;background:#fff;border-radius:18rpx;margin:14rpx 0;padding:22rpx}.project-main{flex:1;min-width:0}.project-name{font-size:28rpx;font-weight:600}.project-sub,.empty{color:#89978d;font-size:23rpx;margin-top:10rpx}.delete{margin:0;background:#f5edea;color:#9d6a5d;font-size:22rpx;border-radius:12rpx}.empty{padding:36rpx 0}
