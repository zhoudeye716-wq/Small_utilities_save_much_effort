ius:50%;border:1px solid #ddd}.placeholder {padding:120rpx 24rpx;text-align:center;color:#7d8b7e}.primary {background:#557961;color:#fff;border-radius:15rpx}.placeholder .primary {margin-top:32rpx}.loading {color:#527462;text-align:center}.hidden-canvas {position:fixed;left:-10000px;top:-10000px;width:1px;height:1px}.mask {position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end;justify-content:center;background:rgba(29,40,32,.5)}.sheet {box-sizing:border-box;background:#fffdf8;border-radius:30rpx 30rpx 0 0;width:100%;max-width:850px;padding:30rpx;max-height:85vh}.sheet-title {font-size:32rpx;font-weight:700;margin-bottom:22rpx}.sheet-title text {float:right;font-size:42rpx;line-height:1}.palette,.export-options {max-height:56vh}.palette-grid {display:grid;grid-template-columns:repeat(auto-fill,minmax(80rpx,1fr));gap:12rpx}.palette-cell {font-size:19rpx;text-align:center}.palette-cell view {height:55rpx;border-radius:9rpx;border:1px solid #ddd}.sheet .primary {margin-top:20rpx}.profile {display:flex;align-items:center;padding:12rpx 0;border-bottom:1px solid #eee}.profile text {flex:1}.profile button {margin:0}.calibration-actions {display:flex;gap:16rpx}.calibration-actions button {flex:1}.calibration-bar {position:fixed;bottom:0;left:0;right:0;z-index:110;display:flex;gap:12rpx;padding:16rpx;background:rgba(255,253,248,.96);align-items:center}.calibration-bar button {margin:0;flex:none}.wheel {flex:1;text-align:center;background:repeating-linear-gradient(90deg,#d7ded0 0,#d7ded0 3px,#edf0e7 3px,#edf0e7 10px);border-radius:14rpx;color:#4d6857;padding:10rpx;touch-action:none}.wheel text {display:block;font-size:17rpx;background:#f7f7f0}.option switch {transform:scale(.8);transform-origin:right}.editbar text {font-size:22rpx}.editbar button {font-size:21rpx}@media (orientation:landscape) {.stage {height:65vh}.page {padding-left:5%;padding-right:5%}.mask {align-items:center}.sheet {border-radius:24rpx}}
