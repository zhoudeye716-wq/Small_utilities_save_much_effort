page { background: #0b2115; color: #f0e7c9; }
.people-page { max-width: 840rpx; margin: 0 auto; padding: 30rpx 28rpx 70rpx; }
.page-heading { padding: 12rpx 4rpx 26rpx; }
.eyebrow { color: #87ae97; font-size: 21rpx; letter-spacing: 3rpx; }
.page-title { margin-top: 8rpx; font-size: 40rpx; font-weight: 800; }
.page-caption, .section-caption { color: #9bbba4; font-size: 23rpx; line-height: 1.55; }
.page-caption { margin-top: 10rpx; }
.section-heading, .player-row, .player-main, .group-row, .group-actions { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.section-heading { margin: 0 4rpx 18rpx; }
.section-title { color: #f2e9c9; font-size: 33rpx; font-weight: 800; }
.section-caption { margin-top: 6rpx; }
.text-action, .group-change { color: #77d1ae; font-size: 24rpx; }
.text-action, .danger-link { white-space: nowrap; }
.danger-link { color: #e3a5a0; font-size: 23rpx; }
.panel { padding: 24rpx; margin-bottom: 28rpx; border-color: rgba(190, 213, 190, .14); }
.player-row, .group-row { min-height: 95rpx; padding: 16rpx 0; border-bottom: 1rpx solid rgba(208, 230, 207, .09); }
.player-main { flex: 1; min-width: 0; }
.player-name, .group-name { color: #ebead3; font-size: 27rpx; font-weight: 700; word-break: break-all; }
.edit-hint { color: #8eb39b; font-size: 21rpx; font-weight: 400; white-space: nowrap; }
.group-change { max-width: 45%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.group-info { min-width: 0; }
.members { margin-top: 6rpx; color: #9bbba4; font-size: 22rpx; word-break: break-all; }
.group-actions { flex: none; gap: 20rpx; }
.empty { padding: 18rpx 4rpx 12rpx; color: #9bbba4; font-size: 24rpx; line-height: 1.6; }
.outline-button { display: flex; min-height: 82rpx; align-items: center; justify-content: center; margin-top: 20rpx; border: 1rpx solid #5b856b; border-radius: 16rpx; color: #cce4d1; background: #214431; font-size: 28rpx; font-weight: 700; }
.footer-note { padding-top: 4rpx; color: #779883; font-size: 22rpx; text-align: center; }
.warning { padding: 18rpx; border-radius: 12rpx; color: #ffc4a9; background: rgba(149, 82, 70, .28); font-size: 24rpx; }
.dialog-backdrop { position: fixed; z-index: 100; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(0, 0, 0, .68); }
.dialog-card { width: 100%; max-width: 610rpx; max-height: 80vh; overflow-y: auto; padding: 30rpx; border: 1rpx solid #52755e; border-radius: 24rpx; background: #17382a; box-shadow: 0 18rpx 60rpx rgba(0, 0, 0, .4); }
.dialog-title { color: #f5e8c4; font-size: 32rpx; font-weight: 800; }
.dialog-note, .dialog-warning { margin-top: 18rpx; color: #aecbb5; font-size: 24rpx; line-height: 1.6; word-break: break-all; }
.dialog-warning { color: #ffc4a9; }
.dialog-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.dialog-option { min-width: 140rpx; max-width: 100%; padding: 18rpx 22rpx; border: 1rpx solid #4b745d; border-radius: 14rpx; color: #deebd9; background: #244b35; font-size: 26rpx; text-align: center; word-break: break-all; }
.dialog-option.chosen { border-color: #6acbaa; color: #9ff0d0; background: #245b44; }
.dialog-input { width: 100%; min-height: 82rpx; margin-top: 20rpx; padding: 12rpx 16rpx; border: 1rpx solid #5b836b; border-radius: 12rpx; color: #f4edce; background: #102c1e; font-size: 28rpx; }
.dialog-error { margin-top: 10rpx; color: #ffbbaa; font-size: 23rpx; }
.dialog-actions { display: flex; gap: 12rpx; margin-top: 26rpx; }
.dialog-actions button, .dialog-cancel-wide { flex: 1; min-height: 78rpx; border-radius: 13rpx; font-size: 27rpx; font-weight: 700; line-height: 78rpx; }
.dialog-cancel, .dialog-cancel-wide { color: #c4dcc9; background: #28503a; }
.dialog-cancel-wide { width: 100%; margin-top: 24rpx; }
.dialog-confirm { color: white; background: #218d6d; }
.dialog-confirm.danger { background: #955246; }
