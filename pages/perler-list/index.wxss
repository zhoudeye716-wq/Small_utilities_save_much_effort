page {background:#f6f2eb;color:#2d302e}.page {max-width:960px;margin:auto;padding:36rpx 32rpx 64rpx;box-sizing:border-box}.hero {padding:32rpx 4rpx}.eyebrow {font-size:21rpx;letter-spacing:3rpx;color:#a76760;font-weight:700}.title {font-size:46rpx;font-weight:800;margin-top:20rpx}.intro {font-size:25rpx;color:#788079;margin-top:12rpx}.create {display:flex;align-items:center;text-align:left;margin:28rpx 0 52rpx;padding:24rpx 30rpx;border-radius:24rpx;background:#546e61;color:white;font-size:30rpx;font-weight:700;line-height:1.7;box-shadow:0 12rpx 26rpx rgba(64,88,69,.17)}.create::after,.remove::after {border:0}.plus {font-size:45rpx;margin-right:24rpx}.arrow {margin-left:auto}.heading {font-size:30rpx;font-weight:700;margin-bottom:18rpx}.count {float:right;color:#9aa099;font-size:23rpx;font-weight:400}.project {display:flex;align-items:center;gap:22rpx;padding:18rpx;margin-bottom:16rpx;background:#fff;border-radius:22rpx}.thumb {width:112rpx;height:112rpx;border-radius:14rpx;background:#eee;flex:none}.details {min-width:0;flex:1}.name {font-size:28rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.meta {font-size:21rpx;color:#929a92;margin-top:12rpx}.remove {padding:0 18rpx;margin:0;background:#f7efeb;color:#b5746d;font-size:22rpx;line-height:60rpx}.next {font-size:36rpx;color:#a3ada3}.empty {padding:70rpx 20rpx;text-align:center;color:#9ba49a;font-size:24rpx}.privacy {margin-top:50rpx;padding:20rpx 24rpx;border-radius:16rpx;background:#eeeae0;color:#697467;font-size:22rpx;line-height:1.6}
