page { background: #0b2115; color: #f0e3ba; }
.history-page { padding: 48rpx 32rpx 64rpx; box-sizing: border-box; max-width: 840rpx; margin: 0 auto; }
.intro { padding: 4rpx 4rpx 34rpx; }
.eyebrow { color: #80a795; font-size: 20rpx; letter-spacing: 3rpx; }
.heading { margin-top: 12rpx; font-size: 48rpx; font-weight: 700; letter-spacing: 3rpx; }
.description { margin-top: 12rpx; color: #a9c2af; font-size: 26rpx; line-height: 1.5; }
.create-row { display: flex; align-items: stretch; gap: 14rpx; }
.create-button { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 96rpx; border-radius: 22rpx; background: linear-gradient(110deg, #32926a, #1e7252); color: #fff; font-size: 32rpx; font-weight: 700; box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, .16); }
.guide-choice { display: flex; flex: none; align-items: center; justify-content: center; gap: 9rpx; padding: 0 20rpx; border: 2rpx solid #799b7e; border-radius: 20rpx; background: #1e3c2c; color: #d0e2ce; font-size: 25rpx; font-weight: 700; }
.guide-choice.enabled { border-color: #69cda5; background: #285e43; color: #effcf0; }
.guide-check { width: 31rpx; height: 31rpx; border: 2rpx solid #b4cbb5; border-radius: 7rpx; line-height: 31rpx; text-align: center; font-size: 24rpx; }
.guide-choice.enabled .guide-check { border-color: #8ce0b5; background: #288a62; color: white; }
.create-plus { margin-right: 10rpx; font-size: 38rpx; font-weight: 400; }
.people-button { display: flex; align-items: center; justify-content: space-between; min-height: 86rpx; margin-top: 16rpx; padding: 0 28rpx; border: 1rpx solid #50735b; border-radius: 18rpx; color: #c9e4d0; background: #1d3d2a; font-size: 27rpx; font-weight: 600; }
.history-heading { display: flex; align-items: center; justify-content: space-between; margin: 48rpx 4rpx 20rpx; }
.section-title { font-size: 32rpx; font-weight: 700; }
.session-count { color: #86a994; font-size: 24rpx; }
.session-list { display: flex; flex-direction: column; gap: 16rpx; }
.session-card { display: flex; align-items: center; justify-content: space-between; min-height: 126rpx; padding: 24rpx 28rpx; box-sizing: border-box; border: 2rpx solid rgba(192, 222, 201, .1); border-radius: 24rpx; background: rgba(35, 63, 46, .75); }
.session-main { flex: 1; min-width: 0; }
.session-title { overflow: hidden; color: #f3e8c5; font-size: 31rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.session-meta { margin-top: 12rpx; color: #9bb9a4; font-size: 23rpx; line-height: 1.5; }
.session-arrow { padding-left: 20rpx; color: #7bab91; font-size: 46rpx; line-height: 1; }
.empty-state { padding: 66rpx 24rpx; border: 2rpx solid rgba(192, 222, 201, .09); border-radius: 24rpx; background: rgba(35, 63, 46, .5); text-align: center; }
.empty-icon { margin-bottom: 14rpx; font-size: 50rpx; }
.empty-title { color: #e7dbb9; font-size: 29rpx; font-weight: 600; }
.empty-copy { margin-top: 12rpx; color: #9bb9a4; font-size: 24rpx; line-height: 1.6; }
.storage-hint { margin-top: 34rpx; color: #779883; font-size: 22rpx; line-height: 1.5; text-align: center; }
.saved-record { margin-top: 14rpx; padding: 12rpx 14rpx; border-radius: 12rpx; color: #b8ddc4; background: #204834; font-size: 21rpx; line-height: 1.5; }
.saved-scores { margin-top: 5rpx; color: #e4e9d0; white-space: normal; word-break: break-all; }
.manage-action { padding: 10rpx 14rpx; border-radius: 10rpx; color: #9de1c3; background: #204834; font-size: 24rpx; }
.delete-action { flex: none; margin-left: 16rpx; padding: 15rpx 22rpx; border: 1rpx solid #a8665b; border-radius: 12rpx; color: #ffc5b5; background: #5b382f; font-size: 24rpx; }
.dialog-backdrop { position: fixed; z-index: 100; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(0, 0, 0, .68); }
.dialog-card { width: 100%; max-width: 610rpx; padding: 30rpx; border: 1rpx solid #52755e; border-radius: 24rpx; background: #17382a; }
.dialog-title { color: #f5e8c4; font-size: 32rpx; font-weight: 800; }
.dialog-message { margin-top: 18rpx; color: #e7ead8; font-size: 26rpx; line-height: 1.6; word-break: break-all; }
.dialog-note { margin-top: 10rpx; color: #aecbb5; font-size: 23rpx; }
.dialog-actions { display: flex; gap: 12rpx; margin-top: 26rpx; }
.dialog-actions button { flex: 1; min-height: 78rpx; border-radius: 13rpx; font-size: 27rpx; font-weight: 700; line-height: 78rpx; }
.dialog-cancel { color: #c4dcc9; background: #28503a; }
.dialog-confirm { color: white; background: #218d6d; }
.dialog-confirm.danger { background: #955246; }
