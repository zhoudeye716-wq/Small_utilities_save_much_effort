<view class="history-page">
  <view class="intro">
    <view class="eyebrow">MAHJONG · SETTLEMENT</view>
    <view class="heading">麻将清算</view>
    <view class="description">记录点数和台费，最后轻松算清楚</view>
  </view>

  <view class="create-row">
    <view class="create-button" role="button" aria-label="新建麻将对局" bindtap="createSession"><text class="create-plus">＋</text><text>新建对局</text></view>
    <view class="guide-choice {{guideEnabled ? 'enabled' : ''}}" role="checkbox" aria-checked="{{guideEnabled}}" bindtap="toggleGuide"><text class="guide-check">{{guideEnabled ? '✓' : ''}}</text><text>新手引导</text></view>
  </view>
  <view class="people-button" role="button" aria-label="管理全局玩家和组合" bindtap="managePeople"><text>玩家与组合</text><text>管理 ›</text></view>

  <view class="history-heading">
    <view class="section-title">对局记录 <text wx:if="{{sessions.length}}" class="session-count">{{sessions.length}} 场</text></view>
    <view wx:if="{{sessions.length}}" class="manage-action" bindtap="toggleManagement">{{managing ? '完成' : '管理对局'}}</view>
  </view>

  <view wx:if="{{storageInvalid}}" class="empty-state">
    <view class="empty-title">暂时无法读取对局记录</view>
    <view class="empty-copy">请稍后重新打开，避免覆盖已有记录。</view>
  </view>
  <view wx:elif="{{!sessions.length}}" class="empty-state">
    <view class="empty-icon">🀄</view>
    <view class="empty-title">还没有对局记录</view>
    <view class="empty-copy">新建一场对局，随时回来继续记录。</view>
  </view>
  <view wx:else class="session-list">
    <view class="session-card" wx:for="{{sessions}}" wx:key="id" data-id="{{item.id}}" bindtap="selectSession" role="button" aria-label="打开{{item.title}}">
      <view class="session-main">
        <view class="session-title">{{item.title}}</view>
        <view class="session-meta">更新于 {{item.updatedLabel}} · 记录 {{item.roundCount}} 轮</view>
        <view wx:if="{{item.recordCount}}" class="saved-record" data-id="{{item.id}}" data-record="{{item.latestRecordId}}" catchtap="selectRecord"><view>清算于 {{item.latestDate}}　›</view><view class="saved-scores">{{item.latestScores}} 点</view></view>
      </view>
      <view wx:if="{{managing}}" class="delete-action" data-id="{{item.id}}" catchtap="requestDelete">删除</view><view wx:else class="session-arrow">›</view>
    </view>
  </view>
  <view class="storage-hint">对局记录保存在本机，请勿清除小程序数据</view>
  <view wx:if="{{deleteDialog}}" class="dialog-backdrop" bindtap="cancelDelete"><view class="dialog-card" catchtap="absorbTap"><view class="dialog-title">{{deleteDialog.step === 1 ? '删除对局' : '再次确认删除'}}</view><view class="dialog-message">{{deleteDialog.step === 1 ? '确定要删除“' + deleteDialog.title + '”吗？' : '这场对局的所有轮次、台费和清算记录都会从本机删除，删除后无法恢复。'}}</view><view class="dialog-note">本机玩家昵称名单会保留。</view><view class="dialog-actions"><button class="dialog-cancel" bindtap="cancelDelete">取消</button><button wx:if="{{deleteDialog.step === 1}}" class="dialog-confirm" bindtap="nextDelete">继续删除</button><button wx:else class="dialog-confirm danger" bindtap="confirmDelete">确认删除</button></view></view></view>
</view>
