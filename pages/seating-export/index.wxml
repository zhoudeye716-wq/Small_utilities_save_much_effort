<view class="page">
  <view class="heading">导出座位图</view><view class="hint">{{cropping?'在预览上拖出需要导出的范围。':'橙色边框内是导出的图片；图片过大时会自动分块保存。'}}</view>
  <view class="preview"><canvas type="2d" id="preview" class="preview-canvas" bindtouchstart="cropStart" bindtouchmove="cropMove" bindtouchend="cropEnd" bindtouchcancel="cropCancel"/></view>
  <view class="actions"><button size="mini" bindtap="startCrop">框选范围</button><button size="mini" bindtap="resetCrop">恢复全图</button></view>
  <view class="card style-card">
    <view class="style-title">选择排版风格</view>
    <view class="style-subtitle">四种预设，点击后可在上方预览</view>
    <view class="preset-grid"><button wx:for="{{stylePresets}}" wx:key="id" class="preset-choice {{activeStyle===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="applyStylePreset">{{item.label}}</button></view>
  </view>
  <view class="card">
    <view class="field"><text>背景与 Logo</text><view><button size="mini" bindtap="chooseBackground">背景</button><button size="mini" bindtap="chooseLogo">Logo</button></view></view><view class="actions"><button size="mini" data-kind="background" bindtap="removeAsset">移除背景</button><button size="mini" data-kind="logo" bindtap="removeAsset">移除 Logo</button></view>
    <view wx:if="{{projectHasLogo}}"><view class="field"><text>Logo 位置</text></view><view class="corner-grid"><button data-corner="top-left" bindtap="setLogoCorner" class="{{logoCorner==='top-left'?'selected':''}}">左上</button><button data-corner="top-right" bindtap="setLogoCorner" class="{{logoCorner==='top-right'?'selected':''}}">右上</button><button data-corner="bottom-left" bindtap="setLogoCorner" class="{{logoCorner==='bottom-left'?'selected':''}}">左下</button><button data-corner="bottom-right" bindtap="setLogoCorner" class="{{logoCorner==='bottom-right'?'selected':''}}">右下</button></view><view class="field"><text>Logo 名称</text><input value="{{logoName}}" bindinput="logoNameInput" placeholder="可选" maxlength="50"/></view><view class="field"><text>Logo 大小</text><text>{{logoScale}}%</text></view><slider min="25" max="250" step="5" value="{{logoScale}}" data-key="logoScale" bindchanging="styleInput" bindchange="styleInput" activeColor="#547c63"/></view>
    <view class="field"><text>常用用途 / 尺寸</text><view class="choice" data-kind="paper" bindtap="openChoice">{{paperPresets[paperIndex]}} ▾</view></view>
    <view class="field"><text>活动名称</text><input value="{{eventTitle}}" data-key="eventTitle" bindinput="eventInput" placeholder="可选"/></view><view class="field"><text>日期</text><view class="actions"><view class="choice" data-kind="date" bindtap="openTemporal">{{eventDate || '选择日期'}} ▾</view><button wx:if="{{eventDate}}" size="mini" bindtap="clearDate">清空</button></view></view><view class="field"><text>时间</text><view class="actions"><view class="choice" data-kind="time" bindtap="openTemporal">{{eventTime || '选择时间'}} ▾</view><button wx:if="{{eventTime}}" size="mini" bindtap="clearTime">清空</button></view></view><view class="field"><text>地点</text><input value="{{eventPlace}}" data-key="eventPlace" bindinput="eventInput" placeholder="可选"/></view>
    <view class="field"><text>图片比例</text><view class="choice" data-kind="ratio" bindtap="openChoice">{{ratios[ratioIndex]}} ▾</view></view>
    <view wx:if="{{ratioIndex===8}}"><view class="field"><text>自定义宽高比</text><text>{{customRatio / 100}} : 1</text></view><slider min="10" max="1000" step="5" value="{{customRatio}}" bindchanging="customRatioInput" bindchange="customRatioInput" activeColor="#547c63"/></view>
    <view class="field"><text>全部文字大小</text><text>{{textScale}}%</text></view><slider min="50" max="200" step="5" value="{{textScale}}" data-key="textScale" bindchanging="styleInput" bindchange="styleInput" activeColor="#547c63"/>
    <view class="field"><text>清晰度</text><view class="choice" data-kind="preset" bindtap="openChoice">{{presets[presetIndex]}} ▾</view></view>
    <view class="field"><text>宽（像素）</text><input type="number" value="{{pixelWidth}}" data-key="pixelWidth" bindinput="pixelInput"/></view>
    <view class="field"><text>高（像素）</text><input type="number" value="{{pixelHeight}}" data-key="pixelHeight" bindinput="pixelInput"/></view>
    <view class="field"><text>打印单位</text><view class="choice" data-kind="unit" bindtap="openChoice">{{printUnits[printUnitIndex]}} ▾</view></view>
    <view class="field"><text>打印宽</text><input type="digit" value="{{printWidth}}" data-key="printWidth" bindinput="printInput" placeholder="可选"/></view>
    <view class="field"><text>打印高</text><input type="digit" value="{{printHeight}}" data-key="printHeight" bindinput="printInput" placeholder="可选"/></view>
    <view class="field"><text>打印清晰度（DPI）</text><input type="digit" value="{{dpi}}" data-key="dpi" bindinput="printInput"/></view>
    <view class="field"><text>场地在留白中的位置</text><text>{{position}}%</text></view><slider min="0" max="100" value="{{position}}" bindchanging="positionInput" bindchange="positionInput" activeColor="#547c63"/>
  </view>
  <view wx:if="{{infoWarning}}" class="hint">{{infoWarning}}</view>
  <view wx:if="{{qualityWarning}}" class="hint">{{qualityWarning}}</view>
  <button class="primary" bindtap="saveImage" disabled="{{busy}}">{{busy?'正在保存…':'保存到相册'}}</button><view class="hint">{{status}}</view>
  <view wx:if="{{tileInfo.length && tileTotal>1}}" class="card"><view class="hint">按序号从左到右、从上到下拼接；打印时保持各图对应尺寸及相同比例。以下缩略图仅在本次导出页面中显示。</view><view wx:for="{{tileInfo}}" wx:key="index" class="tile-row"><image src="{{item.image}}" mode="aspectFit"/><view>第 {{item.index}} 张 · {{item.width}} × {{item.height}} 像素<view wx:if="{{item.printWidth}}">打印 {{item.printWidth}} × {{item.printHeight}} {{item.unit}}</view></view></view></view>
  <canvas type="2d" id="export" class="hidden-canvas"/>
  <view wx:if="{{choiceKind}}" class="choice-mask"><view class="choice-sheet"><view class="choice-heading"><text>请选择</text><text bindtap="closeChoice">✕</text></view><scroll-view scroll-y="true" class="choice-list"><view wx:for="{{choiceItems}}" wx:key="*this" class="choice-item" data-index="{{index}}" bindtap="chooseOption">{{item}}</view></scroll-view></view></view>
  <view wx:if="{{temporalKind}}" class="choice-mask"><view class="choice-sheet"><view class="choice-heading"><text>{{temporalKind==='date'?'选择日期':'选择时间'}}</text><text bindtap="closeTemporal">✕</text></view><view wx:if="{{temporalKind==='date'}}" class="temporal-columns"><scroll-view scroll-y="true" scroll-into-view="year-{{temporalYear}}"><view wx:for="{{years}}" wx:key="*this" id="year-{{item}}" class="temporal-item {{item===temporalYear?'selected':''}}" data-key="year" data-value="{{item}}" bindtap="temporalChoose">{{item}} 年</view></scroll-view><scroll-view scroll-y="true" scroll-into-view="month-{{temporalMonth}}"><view wx:for="{{months}}" wx:key="*this" id="month-{{item}}" class="temporal-item {{item===temporalMonth?'selected':''}}" data-key="month" data-value="{{item}}" bindtap="temporalChoose">{{item}} 月</view></scroll-view><scroll-view scroll-y="true" scroll-into-view="day-{{temporalDay}}"><view wx:for="{{days}}" wx:key="*this" id="day-{{item}}" class="temporal-item {{item===temporalDay?'selected':''}}" data-key="day" data-value="{{item}}" bindtap="temporalChoose">{{item}} 日</view></scroll-view></view><view wx:else class="temporal-columns"><scroll-view scroll-y="true" scroll-into-view="hour-{{temporalHour}}"><view wx:for="{{hours}}" wx:key="*this" id="hour-{{item}}" class="temporal-item {{item===temporalHour?'selected':''}}" data-key="hour" data-value="{{item}}" bindtap="temporalChoose">{{item}} 时</view></scroll-view><scroll-view scroll-y="true" scroll-into-view="minute-{{temporalMinute}}"><view wx:for="{{minutes}}" wx:key="*this" id="minute-{{item}}" class="temporal-item {{item===temporalMinute?'selected':''}}" data-key="minute" data-value="{{item}}" bindtap="temporalChoose">{{item}} 分</view></scroll-view></view><button class="primary" bindtap="confirmTemporal">确定</button></view></view>
</view>
