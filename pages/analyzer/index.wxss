.analyzer-page { min-height: 100vh; padding: 30rpx 28rpx 60rpx; background: #082317; }
.intro { padding: 12rpx 6rpx 26rpx; }
.intro-title { color: #f5e9bf; font-size: 42rpx; font-weight: 800; letter-spacing: 2rpx; }
.intro-text { margin-top: 10rpx; color: #a9c6b1; font-size: 25rpx; line-height: 1.55; }
.selection-panel, .deck-panel, .result-panel { padding: 26rpx; }
.selection-heading { display: flex; align-items: center; justify-content: space-between; color: #f1e9cc; font-size: 29rpx; font-weight: 700; }
.selection-count { color: #9fbca8; font-size: 22rpx; font-weight: 400; }
.board-heading { margin-top: 26rpx; }
.cards-row { display: flex; gap: 12rpx; margin-top: 14rpx; }
.card-slot { width: 110rpx; height: 116rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #52735d; border-radius: 14rpx; color: #799984; background: #102d1d; font-size: 37rpx; font-weight: 700; }
.card-slot.active { border-color: #5ad3b1; box-shadow: 0 0 0 3rpx rgba(90, 211, 177, .18); }
.card-slot.filled { background: #f5f2e8; border-style: solid; }
.board-row .card-slot { flex: 1; width: 0; min-width: 0; height: 108rpx; font-size: 31rpx; }
.slot-tip { margin-top: 16rpx; color: #95b9a2; font-size: 22rpx; line-height: 1.45; }
.actions { display: flex; gap: 12rpx; margin-top: 24rpx; }
.actions button { min-height: 80rpx; border-radius: 16rpx; font-size: 29rpx; font-weight: 700; line-height: 80rpx; }
.reset-button { width: 28%; color: #b6d0bc; border: 1rpx solid #50745e; background: #203e2d; }
.analyze-button { flex: 1; color: white; background: #168b72; }
.waiting-tip { flex: 1; display: flex; align-items: center; justify-content: center; color: #a9c6b1; font-size: 23rpx; }
.deck-title { color: #f1e9cc; font-size: 29rpx; font-weight: 700; }
.deck-subtitle { margin: 6rpx 0; color: #9fbea9; font-size: 23rpx; }
.deck-hint { margin-bottom: 16rpx; color: #a9c6b1; font-size: 21rpx; line-height: 1.5; }
.deck-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 18rpx 8rpx; }
.rank-group { display: flex; flex-direction: column; gap: 7rpx; min-width: 0; }
.rank-label { color: #d6e4d3; font-size: 23rpx; font-weight: 700; text-align: center; }
.deck-card { min-height: 72rpx; display: flex; justify-content: center; align-items: center; background: #f4f2e9; border-radius: 9rpx; font-weight: 700; font-size: 25rpx; }
.deck-card.selected { opacity: .3; }
.suit-S { color: #22252a; }
.suit-H { color: #c52b40; }
.suit-C { color: #167d6b; }
.suit-D { color: #266b9b; }
.result-panel { border-color: rgba(93, 208, 168, .4); background: #153c2b; }
.result-label { color: #a6cbb3; font-size: 23rpx; }
.result-title { margin-top: 7rpx; color: #f2d985; font-size: 42rpx; font-weight: 800; }
.result-description, .result-note, .possibility-description { color: #b4d0bc; font-size: 24rpx; line-height: 1.6; }
.result-description { margin-top: 6rpx; }
.result-cards { margin-top: 14rpx; color: #f8edcf; font-size: 29rpx; font-weight: 700; }
.possibility-title { margin-top: 28rpx; color: #f0e8c9; font-size: 29rpx; font-weight: 700; }
.result-note { margin-top: 8rpx; }
.possibility { margin-top: 16rpx; padding: 17rpx 18rpx; border-radius: 14rpx; background: rgba(4, 28, 16, .38); }
.possibility-name { color: #e8d27f; font-size: 28rpx; font-weight: 700; }
.possibility-text { margin-top: 6rpx; color: #e1ead7; font-size: 25rpx; }
.possibility-description { margin-top: 5rpx; }
.final-note { margin-top: 18rpx; }
.continue-select-button { margin-top: 18rpx; padding: 14rpx; border: 1rpx solid #598b70; border-radius: 12rpx; color: #d5eade; background: #24503a; font-size: 25rpx; }
