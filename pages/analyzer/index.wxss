.analyzer-page { min-height: 100vh; padding: 22rpx 30rpx 60rpx; background: #082616; }
.selection-panel { padding: 26rpx; }
.panel-title { font-size: 30rpx; margin-bottom: 20rpx; }
.small { font-size: 22rpx; font-weight: 400; }
.slot-label { color: #8fb29c; font-size: 25rpx; margin: 18rpx 0 10rpx; }
.cards-row { display: flex; gap: 14rpx; }
.card-slot { width: 112rpx; height: 124rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed rgba(199, 220, 199, .24); border-radius: 14rpx; color: #728b78; font-size: 48rpx; background: rgba(2, 19, 10, .12); }
.board-row .card-slot { flex: 1; width: 0; min-width: 0; height: 116rpx; }
.deck-grid { display: grid; grid-template-columns: repeat(9, 1fr); gap: 8rpx; }
.deck-card { min-height: 70rpx; display: flex; justify-content: center; align-items: center; gap: 3rpx; background: #f4f2e9; border-radius: 9rpx; font-weight: 700; font-size: 26rpx; }
.deck-card.selected { opacity: .28; }
.table-panel { padding-bottom: 36rpx; }
.oval-table { position: relative; height: 500rpx; margin: 18rpx 0 0; border: 8rpx solid #288850; border-radius: 50%; background: radial-gradient(ellipse, #075a33, #073c25 72%); }
.table-center { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); display: flex; flex-direction: column; align-items: center; gap: 12rpx; color: #e4c846; font-size: 38rpx; font-weight: 700; }
.table-hint { font-size: 23rpx; color: #91af8c; font-weight: 400; }
.seat { position: absolute; width: 92rpx; height: 92rpx; transform: translate(-50%,-50%); display: flex; align-items: center; justify-content: center; border: 6rpx solid #aab5ae; border-radius: 50%; background: #f3f0dd; color: #263c2d; font-size: 22rpx; font-weight: 700; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.3); }
.seat.dealer { background: #df7b18; border-color: #b84c0b; color: #fff; }
.seat.folded { opacity: .42; background: #747873; }
.seat-stack { position: absolute; top: 100%; color: #60dbc4; background: #09130d; padding: 2rpx 8rpx; white-space: nowrap; }
.seat-role { max-width: 90%; overflow: hidden; }
.parameters-panel { padding: 28rpx; }
.parameter-row { min-height: 84rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid rgba(192, 216, 191, .08); color: #9bb6a3; font-size: 26rpx; }
.compact-input { width: 54%; min-height: 66rpx; text-align: right; font-size: 27rpx; }
.chips-row { display: flex; justify-content: space-between; gap: 8rpx; padding: 12rpx 0 20rpx; }
.chips-row button { flex: 1; width: 0; min-width: 0; padding: 13rpx 2rpx; border-radius: 14rpx; color: #b7d3bd; background: rgba(222, 236, 217, .08); font-size: 21rpx; }
.analysis-note { padding: 22rpx; border: 1rpx solid rgba(50, 177, 153, .32); border-radius: 18rpx; color: #a7d9c8; background: rgba(30, 150, 127, .12); line-height: 1.6; margin-bottom: 18rpx; }
.analysis-caption { display: block; text-align: center; margin-top: 10rpx; }
.analyze-button { width: 62%; margin: 16rpx auto; font-size: 29rpx; }
.bottom-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }
.bottom-actions button { flex: 1; width: 0; min-width: 0; min-height: 72rpx; border-radius: 20rpx; font-size: 24rpx; }
.loss-button { color: #e98d91; border: 1rpx solid rgba(211, 105, 109, .5); background: rgba(120, 47, 51, .22); }
.clear-button { color: #a8c0b0; border: 1rpx solid rgba(180, 210, 190, .2); }
.win-button { color: #e3d56d; border: 1rpx solid rgba(202, 176, 62, .35); background: rgba(127, 111, 37, .2); }
.result-count { text-align: center; padding: 18rpx 0; font-size: 23rpx; }
