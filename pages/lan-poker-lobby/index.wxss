.lobby{min-height:100vh;box-sizing:border-box;padding:32rpx;background:#081f15;color:#ecdfb7}.intro{font-size:40rpx;font-weight:700}.hint{margin:14rpx 0;color:#a4c1aa;font-size:24rpx;line-height:1.5}.card{margin-top:26rpx;padding:30rpx;border:1px solid rgba(186,220,192,.14);border-radius:22rpx;background:#152c20}.label{margin:20rpx 0 10rpx;color:#b9d0ba;font-size:26rpx}.field{height:76rpx;padding:0 18rpx;border-radius:12rpx;background:#253d30;color:#eee2b9}.setting{display:flex;align-items:center;gap:12rpx;padding:16rpx 0;border-bottom:1px solid rgba(255,255,255,.08)}.setting text{flex:1}.setting input{width:120rpx;padding:12rpx;text-align:right;background:#253d30;border-radius:10rpx}.check{padding:22rpx 0;color:#bad8c0}.actions{display:flex;gap:16rpx;margin-top:22rpx}.actions button{flex:1;margin:0}.primary{background:#218a77;color:#fff}.room{display:flex;justify-content:space-between;padding:22rpx 0;border-bottom:1px solid rgba(255,255,255,.1)}.room-name{font-size:32rpx;font-weight:700}.seat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin:24rpx 0}.seat{text-align:center;overflow:hidden;padding:22rpx 5rpx;border:1px solid #526b59;border-radius:12rpx;color:#aac0aa}.seat.taken{background:#30483a;color:#eee0b9}.seat.own{background:#218a77;color:white}.error{color:#ffb2a8;padding:15rpx 0}.overlay{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.75)}.dialog{width:80%;padding:30rpx;border-radius:20rpx;background:#152c20}.dialog .field{margin-top:24rpx}
